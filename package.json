{
  "name": "ultra-builder-pro-cli",
  "version": "6.0.0",
  "description": "Project method and deterministic progress engine for Claude Code and Codex.",
  "bin": {
    "ultra-builder-pro-cli": "bin/install.js",
    "ubp": "bin/install.js"
  },
  "files": [
    "bin",
    "engine",
    "adapters/claude.js",
    "adapters/codex.js",
    "adapters/_shared/*.cjs",
    "skills/ultra",
    "hooks/session-start.cjs",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs/PLUGIN-ISOLATION-CONTRACT.md"
  ],
  "keywords": [
    "claude-code",
    "codex",
    "agent",
    "cli",
    "ultra-builder-pro",
    "file-first"
  ],
  "author": "Ultra Builder Pro contributors",
  "license": "MIT",
  "homepage": "https://github.com/rocky2431/ultra-builder-pro-cli",
  "bugs": {
    "url": "https://github.com/rocky2431/ultra-builder-pro-cli/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rocky2431/ultra-builder-pro-cli.git"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "test": "npm run test:all",
    "test:node": "node --test adapters/_shared/tests/*.test.cjs tests/*.test.cjs",
    "test:all": "npm run test:node",
    "verify:release": "npm run test:all && npm audit --omit=dev --audit-level=high",
    "prepublishOnly": "npm run verify:release",
    "install:claude": "node bin/install.js --claude --local",
    "install:all": "node bin/install.js --all --global",
    "install:codex": "node bin/install.js --codex --global"
  },
  "dependencies": {
    "js-yaml": "^4.3.2"
  }
}
