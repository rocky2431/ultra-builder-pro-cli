+// Characterization (M4): what a delete keeps, whatever the short link answers afterwards. It
+// replaces the test that pinned "its short link answers 404", now test/m4/deleted.test.cjs.
+test('REQ-delete: a deleted link leaves the list, the page and its detail, also after a restart',
+  async (t) => {
+    const first = await start(t);
+    const keep = (await createLink(first.base, { url: 'https://example.com/keep' })).body;
+    const drop = (await createLink(first.base, { url: 'https://example.com/drop' })).body;
+    const res = await remove(first.base, drop.code);
+    assert.equal(res.status, 204);
+    assert.equal(res.text, '', 'no body');
+    const gone = async (base, when) => {
+      assert.deepEqual((await list(base)).body.map((l) => l.code), [keep.code], when);
+      const html = (await page(base)).text;
+      assert.equal(row(html, drop.code), null, `${when}: not on the page`);
+      assert.ok(row(html, keep.code), `${when}: the other link is`);
+      const detail = await fetch(`${base}/api/links/${drop.code}`);
+      assert.equal(detail.status, 404, when);
+      assert.deepEqual(await detail.json(), { error: NO_SUCH }, when);
+      assert.equal((await visit(base, keep.code)).status, 302, `${when}: other links still work`);
+    };
+    await gone(first.base, 'after the delete');
+    await first.stop('SIGKILL');
+    const second = await start(t, first.data);
+    await gone(second.base, 'after a restart');
+    const again = await remove(second.base, drop.code);
+    assert.equal(again.status, 404, 'a deleted link cannot be deleted again');
+    assert.deepEqual(JSON.parse(again.text), { error: NO_SUCH });
+  });
 
