{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ultra-builder-pro.dev/spec/tasks.v4.5.schema.json",
  "title": "tasks.json projection (v4.5)",
  "description": "Read-only checkout-local projection of the tasks table. Generated by the projector; manual edits are overwritten. It includes both durable Task authority and runtime-only fields that never enter the Git team ledger. Authority boundary: docs/DECISIONS.md.",
  "type": "object",
  "required": ["schema_version", "generated_at", "tasks"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "4.5" },
    "generated_at":   { "type": "string", "format": "date-time" },
    "source":         { "const": ".ultra/.runtime/state.db", "description": "authoritative source (D32)" },
    "tasks": {
      "type": "array",
      "items": { "$ref": "#/$defs/task" }
    }
  },
  "$defs": {
    "task": {
      "type": "object",
      "description": "Live Task projection. task_contract may write contract fields only; status/session/freshness/context/timestamps and completion attestation are runtime-owned.",
      "required": ["id", "title", "type", "priority", "status", "created_at", "updated_at"],
      "additionalProperties": false,
      "properties": {
        "id":         { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "title":      { "type": "string", "minLength": 3 },
        "type":       { "type": "string", "minLength": 1, "maxLength": 80 },
        "priority":   { "type": "string", "minLength": 1, "maxLength": 80 },
        "complexity": { "type": "integer", "minimum": 1, "maximum": 10 },
        "estimated_days": { "type": "number", "exclusiveMinimum": 0 },
        "status": {
          "type": "string",
          "enum": ["pending", "in_progress", "completed", "blocked", "expanded"],
          "x-derived": true,
          "description": "DERIVED from state.db tasks.status; never write through this projection"
        },
        "deps": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "x-derived": true,
          "description": "DERIVED from state.db tasks.deps JSON"
        },
        "files_modified": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "description": "Durable path-level conflict surface."
        },
        "session_id": {
          "type": "string",
          "x-derived": true,
          "description": "DERIVED from state.db tasks.session_id (current owning session)"
        },
        "stale": {
          "type": "boolean",
          "x-derived": true,
          "description": "DERIVED from staleness propagation (Phase 5.3)"
        },
        "tag": {
          "type": "string",
          "x-derived": true,
          "description": "Checkout-local runtime tag; never task_contract input."
        },
        "trace_to":         { "type": "string" },
        "outcome":          { "type": "string" },
        "slice_kind":       { "type": "string", "minLength": 1, "maxLength": 80 },
        "public_seam":      { "type": "string" },
        "verification_command": { "type": "string" },
        "acceptance":       { "type": "array", "items": { "type": "object" } },
        "context_refs":     { "type": "array", "items": { "type": "object" } },
        "docs_impact":      { "type": "object" },
        "ownership":        { "type": "object" },
        "context_file": {
          "type": "string",
          "x-derived": true,
          "description": "Checkout-local generated Context path; never task_contract input."
        },
        "completion_commit": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$",
          "x-derived": true,
          "description": "Checkout-local integrated commit proof written only by task_outcome/attest_commit."
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "x-derived": true
        },
        "updated_at": {
          "type": "string",
          "format": "date-time",
          "x-derived": true
        }
      }
    }
  }
}
