{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ultra-builder-pro.dev/schemas/delivery-report.v1.schema.json",
  "title": "Ultra delivery report v1",
  "type": "object",
  "required": [
    "$schema", "change_id", "archive_status", "baseline_id", "baseline_status",
    "git_commit", "worktree_digest", "context_digest", "checks", "rollback", "timestamp"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": { "const": "ultra-delivery-report-v1" },
    "change_id": { "type": ["string", "null"] },
    "archive_status": { "type": ["string", "null"], "enum": ["archived", null] },
    "baseline_id": { "type": ["string", "null"] },
    "baseline_status": { "type": ["string", "null"] },
    "git_commit": { "type": ["string", "null"] },
    "worktree_digest": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
    "context_digest": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["command", "status", "exit_code", "evidence"],
        "additionalProperties": false,
        "properties": {
          "command": { "type": "string", "minLength": 1 },
          "status": { "enum": ["pass", "fail"] },
          "exit_code": { "type": "integer" },
          "evidence": { "type": "string", "minLength": 1 }
        },
        "allOf": [
          {
            "if": { "properties": { "status": { "const": "pass" } } },
            "then": { "properties": { "exit_code": { "const": 0 } } }
          },
          {
            "if": { "properties": { "status": { "const": "fail" } } },
            "then": { "properties": { "exit_code": { "not": { "const": 0 } } } }
          }
        ]
      }
    },
    "rollback": { "type": ["string", "null"] },
    "timestamp": { "type": ["string", "null"], "format": "date-time" }
  },
  "allOf": [
    {
      "if": { "properties": { "archive_status": { "const": "archived" } } },
      "then": {
        "properties": {
          "change_id": { "type": "string", "minLength": 1 },
          "baseline_id": { "type": "string", "minLength": 1 },
          "baseline_status": { "type": "string", "minLength": 1 },
          "context_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "checks": {
            "minItems": 1,
            "items": { "properties": { "status": { "const": "pass" }, "exit_code": { "const": 0 } } }
          },
          "rollback": { "type": "string", "minLength": 1 },
          "timestamp": { "type": "string", "format": "date-time" }
        }
      }
    }
  ]
}
