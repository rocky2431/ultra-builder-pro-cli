{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ultra-builder-pro.dev/schemas/documentation-reconciliation.v1.schema.json",
  "title": "Ultra documentation reconciliation v1",
  "type": "object",
  "required": [
    "$schema",
    "change_id",
    "delta_artifact_id",
    "delta_digest",
    "documents"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": { "const": "ultra-documentation-reconciliation-v1" },
    "change_id": { "type": "string", "minLength": 1 },
    "delta_artifact_id": { "type": "string", "minLength": 1 },
    "delta_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "no_change_reason": { "type": "string", "minLength": 3 },
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "action",
          "overlay_path",
          "before_digest",
          "after_digest",
          "delta_refs",
          "acceptance_refs",
          "verification",
          "consumers"
        ],
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "action": { "enum": ["add", "update"] },
          "overlay_path": { "type": "string", "minLength": 1 },
          "before_digest": {
            "type": ["string", "null"],
            "pattern": "^[0-9a-f]{64}$"
          },
          "after_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "delta_refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "acceptance_refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "verification": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["command", "status", "evidence_refs"],
              "additionalProperties": false,
              "properties": {
                "command": { "type": "string", "minLength": 1 },
                "status": { "const": "pass" },
                "evidence_refs": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": { "type": "string", "minLength": 1 }
                }
              }
            }
          },
          "consumers": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["type", "id", "relation"],
              "additionalProperties": false,
              "properties": {
                "type": {
                  "enum": ["artifact", "project", "baseline", "change", "task", "workflow", "external"]
                },
                "id": { "type": "string", "minLength": 1 },
                "relation": { "type": "string", "minLength": 1 }
              }
            }
          },
          "no_consumer_reason": { "type": "string", "minLength": 3 }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "documents": { "maxItems": 0 }
        }
      },
      "then": { "required": ["no_change_reason"] }
    }
  ]
}
