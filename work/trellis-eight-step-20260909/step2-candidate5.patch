diff --git a/tests/unified-entry.test.cjs b/tests/unified-entry.test.cjs
new file mode 100644
index 0000000..ee7814f
--- /dev/null
+++ b/tests/unified-entry.test.cjs
@@ -0,0 +1,255 @@
+'use strict';
+
+const { after, test } = require('node:test');
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const os = require('node:os');
+const path = require('node:path');
+const { spawnSync } = require('node:child_process');
+
+const ROOT = path.resolve(__dirname, '..');
+const CLI = path.join(ROOT, 'bin', 'install.js');
+
+function temporary(prefix) {
+  return fs.mkdtempSync(path.join(os.tmpdir(), prefix));
+}
+
+const SANDBOX = temporary('ubp-run-');
+after(() => fs.rmSync(SANDBOX, { recursive: true, force: true }));
+
+// One real managed plugin, generated by the production adapter, is the fixture: the
+// entry must describe the plugin that a host would actually load.
+const CONFIG_DIR = path.join(SANDBOX, 'config');
+const PLUGIN_ROOT = path.join(CONFIG_DIR, 'skills', 'ultra-builder-pro');
+require('../adapters/claude.js').install({ repoRoot: ROOT, configDir: CONFIG_DIR, scope: 'global' });
+
+// A stand-in for the host binary records how it was actually invoked and controls its
+// own exit code. It is a PATH stub for `claude`, not a fake model or permission
+// callback: nothing about Ultra's behaviour is simulated by it.
+const HOST_BIN = path.join(SANDBOX, 'bin');
+const RECEIPT = path.join(SANDBOX, 'host-receipt.txt');
+fs.mkdirSync(HOST_BIN, { recursive: true });
+fs.writeFileSync(path.join(HOST_BIN, 'claude'), `#!/bin/sh
+{
+  echo "cwd=$PWD"
+  for arg in "$@"; do
+    printf 'arg<%s>\\n' "$arg"
+  done
+  if [ -n "$UBP_TEST_READ_STDIN" ]; then
+    IFS= read -r answer
+    printf 'answer<%s>\\n' "$answer"
+  fi
+} > "$UBP_TEST_RECEIPT"
+if [ -n "$UBP_TEST_SIGNAL" ]; then
+  kill -s "$UBP_TEST_SIGNAL" "$$"
+fi
+exit "\${UBP_TEST_EXIT_CODE:-0}"
+`);
+fs.chmodSync(path.join(HOST_BIN, 'claude'), 0o755);
+
+function run(args, options = {}) {
+  return spawnSync(process.execPath, [CLI, 'run', ...args], {
+    cwd: options.cwd || ROOT,
+    encoding: 'utf8',
+    input: options.input,
+    env: {
+      ...process.env,
+      PATH: [HOST_BIN, path.dirname(process.execPath), process.env.PATH || '']
+        .filter(Boolean)
+        .join(path.delimiter),
+      UBP_TEST_RECEIPT: RECEIPT,
+      ...options.env,
+    },
+  });
+}
+
+function dryRun(args, options) {
+  const result = run(['--dry-run', '--json', '--plugin-dir', PLUGIN_ROOT, ...args], options);
+  assert.equal(result.status, 0, result.stderr || result.stdout);
+  return JSON.parse(result.stdout);
+}
+
+function receipt() {
+  const text = fs.readFileSync(RECEIPT, 'utf8');
+  const answer = /^answer<([\s\S]*?)>$/mu.exec(text);
+  return {
+    cwd: /^cwd=(.*)$/mu.exec(text)[1],
+    args: [...text.matchAll(/^arg<([\s\S]*?)>$/gmu)].map((match) => match[1]),
+    answer: answer ? answer[1] : null,
+  };
+}
+
+test('the goal reaches the host verbatim, with the real plugin named for it', () => {
+  const goal = 'fix the CSV export mojibake in the report writer';
+  const observed = dryRun([goal]);
+
+  assert.equal(observed.goal, goal);
+  assert.ok(observed.prompt.endsWith(`\n\n${goal}`), 'goal must be the final prompt segment');
+  assert.equal(observed.prompt.split(goal).length, 2, 'goal must appear once, unaltered');
+  assert.equal(observed.command, 'claude');
+  assert.deepEqual(observed.args, ['--plugin-dir', PLUGIN_ROOT, '--', observed.prompt]);
+  assert.equal(observed.plugin.root, PLUGIN_ROOT);
+  assert.equal(observed.plugin.version, require('../package.json').version);
+  // Entry instructions are the packaged asset rendered against that plugin, never a
+  // template left unrendered or a path the caller cannot verify.
+  assert.doesNotMatch(observed.prompt, /\{\{[a-z_]+\}\}/u);
+  assert.ok(observed.prompt.includes(PLUGIN_ROOT));
+  assert.ok(fs.existsSync(path.join(
+    PLUGIN_ROOT, 'skills', 'ultra-status', 'references', 'route-contract.md',
+  )));
+});
+
+test('multi-word, quoted, and option-shaped goals survive argv without being dropped', () => {
+  const spaced = dryRun(['tidy', 'my', 'scattered', 'meeting', 'notes']);
+  assert.equal(spaced.goal, 'tidy my scattered meeting notes');
+
+  const multiline = dryRun(['line one\nline two  with  spacing']);
+  assert.equal(multiline.goal, 'line one\nline two  with  spacing');
+
+  const dashed = dryRun(['--', '--not-a-flag but a goal']);
+  assert.equal(dashed.goal, '--not-a-flag but a goal');
+
+  const unicode = dryRun(['把导出的 CSV 乱码修好']);
+  assert.equal(unicode.goal, '把导出的 CSV 乱码修好');
+});
+
+test('a goal can arrive on stdin, and an empty request is refused', () => {
+  const piped = dryRun(['-'], { input: 'build me something to tidy my notes\n' });
+  assert.equal(piped.goal, 'build me something to tidy my notes');
+
+  const implicit = dryRun([], { input: 'goal without a dash\n' });
+  assert.equal(implicit.goal, 'goal without a dash');
+
+  const empty = run(['--plugin-dir', PLUGIN_ROOT], { input: '   \n' });
+  assert.notEqual(empty.status, 0);
+  assert.match(empty.stderr, /goal is required/u);
+  assert.equal(empty.stdout, '');
+});
+
+test('native host arguments pass through in order, before the prompt', () => {
+  const observed = dryRun(['--host-arg', '--permission-mode', '--host-arg', 'plan', 'read only please']);
+  assert.deepEqual(observed.args, [
+    '--plugin-dir', PLUGIN_ROOT, '--permission-mode', 'plan', '--', observed.prompt,
+  ]);
+  assert.match(observed.resume, /ubp run --continue/u);
+});
+
+test('the prompt is positional even after a variadic native option', () => {
+  const observed = dryRun(['--host-arg', '--allowedTools', '--host-arg', 'Bash', 'build a notes tool']);
+  assert.deepEqual(observed.args, [
+    '--plugin-dir', PLUGIN_ROOT, '--allowedTools', 'Bash', '--', observed.prompt,
+  ]);
+});
+
+test('continuation and named resume keep loading the selected plugin', () => {
+  const continued = dryRun(['--continue', 'continue the requested change']);
+  assert.deepEqual(continued.args, ['--plugin-dir', PLUGIN_ROOT, '--continue', '--', continued.prompt]);
+
+  const resumed = dryRun(['--resume', 'recorded-session', 'finish the interrupted change']);
+  assert.deepEqual(resumed.args, [
+    '--plugin-dir', PLUGIN_ROOT, '--resume', 'recorded-session', '--', resumed.prompt,
+  ]);
+  const conflicting = run(['--plugin-dir', PLUGIN_ROOT, '--continue', '--resume', 'id', 'finish']);
+  assert.notEqual(conflicting.status, 0);
+  assert.match(conflicting.stderr, /--continue or --resume/u);
+});
+
+test('unsupported hosts, missing plugins, and bad options fail before any launch', () => {
+  fs.rmSync(RECEIPT, { force: true });
+
+  const host = run(['--host', 'codex', 'a goal']);
+  assert.notEqual(host.status, 0);
+  assert.match(host.stderr, /cannot start "codex"/u);
+  assert.match(host.stderr, /claude/u);
+
+  const missing = run(['--plugin-dir', path.join(SANDBOX, 'absent'), 'a goal']);
+  assert.notEqual(missing.status, 0);
+  assert.match(missing.stderr, /no managed Ultra plugin/u);
+
+  const unknown = run(['--plugin-dir', PLUGIN_ROOT, '--nope', 'a goal']);
+  assert.notEqual(unknown.status, 0);
+  assert.match(unknown.stderr, /unknown option for ubp run/u);
+
+  const conflicting = run(['--plugin-dir', PLUGIN_ROOT, '--config-dir', CONFIG_DIR, 'a goal']);
+  assert.notEqual(conflicting.status, 0);
+  assert.match(conflicting.stderr, /--plugin-dir or --config-dir/u);
+
+  const jsonOnly = run(['--plugin-dir', PLUGIN_ROOT, '--json', 'a goal']);
+  assert.notEqual(jsonOnly.status, 0);
+  assert.match(jsonOnly.stderr, /--json is available only with --dry-run/u);
+
+  assert.equal(fs.existsSync(RECEIPT), false, 'no host process may start on a refusal');
+});
+
+test('a dry run prints the command it would start and starts nothing', () => {
+  fs.rmSync(RECEIPT, { force: true });
+  const observed = run(['--dry-run', '--plugin-dir', PLUGIN_ROOT, 'a goal']);
+  assert.equal(observed.status, 0, observed.stderr);
+  assert.match(observed.stdout, /claude --plugin-dir/u);
+  assert.match(observed.stdout, /Resume:/u);
+  assert.equal(fs.existsSync(RECEIPT), false);
+});
+
+test('the real command starts the host with the dry-run argv and returns its exit code', () => {
+  const goal = 'add a --since flag to the export command';
+  const planned = dryRun([goal]);
+  const cwd = path.join(SANDBOX, 'project');
+  fs.mkdirSync(cwd, { recursive: true });
+
+  const started = run(['--plugin-dir', PLUGIN_ROOT, '--cwd', cwd, goal]);
+  assert.equal(started.status, 0, started.stderr);
+  const first = receipt();
+  assert.deepEqual(first.args, planned.args);
+  assert.equal(first.cwd, fs.realpathSync(cwd));
+  assert.ok(first.args[first.args.length - 1].endsWith(goal));
+
+  const failed = run(['--plugin-dir', PLUGIN_ROOT, goal], { env: { UBP_TEST_EXIT_CODE: '3' } });
+  assert.equal(failed.status, 3, 'the host exit code is the command exit code');
+
+  const signalled = run(['--plugin-dir', PLUGIN_ROOT, goal], { env: { UBP_TEST_SIGNAL: 'TERM' } });
+  assert.equal(signalled.status, 143, 'native termination stays distinguishable from a launch error');
+
+  const absentHost = run(['--plugin-dir', PLUGIN_ROOT, goal], {
+    env: { PATH: path.dirname(process.execPath) },
+  });
+  assert.notEqual(absentHost.status, 0);
+  assert.match(absentHost.stderr, /not on PATH/u);
+});
+
+test('the started host owns the terminal, so the owner can answer its questions', () => {
+  // Ultra does not answer for the owner: the command inherits stdio and the host reads
+  // the reply itself. This observes that inheritance at the process boundary.
+  const answered = run(['--plugin-dir', PLUGIN_ROOT, 'build a small notes tool'], {
+    env: { UBP_TEST_READ_STDIN: '1' },
+    input: 'just for me, and I need to find past decisions by keyword\n',
+  });
+  assert.equal(answered.status, 0, answered.stderr);
+  assert.equal(receipt().answer, 'just for me, and I need to find past decisions by keyword');
+});
+
+test('run is a subcommand and the installer argv contract is unchanged', () => {
+  const help = spawnSync(process.execPath, [CLI, '--help'], { cwd: ROOT, encoding: 'utf8' });
+  assert.equal(help.status, 0, help.stderr);
+  assert.match(help.stdout, /ubp run/u);
+
+  const runHelp = run(['--help']);
+  assert.equal(runHelp.status, 0, runHelp.stderr);
+  assert.match(runHelp.stdout, /Usage: ubp run/u);
+
+  const version = spawnSync(process.execPath, [CLI, '--version'], { cwd: ROOT, encoding: 'utf8' });
+  assert.equal(version.status, 0, version.stderr);
+
+  // `run` is only a subcommand in first position; elsewhere it stays the pre-existing
+  // rejected positional, so no installed invocation changes meaning.
+  const positional = spawnSync(process.execPath, [CLI, '--claude', 'run'], {
+    cwd: ROOT, encoding: 'utf8',
+  });
+  assert.notEqual(positional.status, 0);
+  assert.match(positional.stderr, /unexpected positional argument: run/u);
+
+  const doctor = spawnSync(process.execPath, [
+    CLI, '--claude', '--global', '--config-dir', CONFIG_DIR, '--doctor', '--json',
+  ], { cwd: ROOT, encoding: 'utf8' });
+  assert.equal(doctor.status, 0, doctor.stderr || doctor.stdout);
+  assert.equal(JSON.parse(doctor.stdout).status, 'healthy');
+});
