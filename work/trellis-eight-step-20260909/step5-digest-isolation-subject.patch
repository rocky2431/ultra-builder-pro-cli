+  fs.mkdirSync(path.dirname(sdkPackageFile), { recursive: true });
+  const writeSdkPackage = (payload) => fs.writeFileSync(
+    sdkPackageFile,
+    `${JSON.stringify(payload)}\n`,
+  );
+  writeSdkPackage({
+    name: '@anthropic-ai/claude-agent-sdk', version: '0.3.257', main: 'index.js',
