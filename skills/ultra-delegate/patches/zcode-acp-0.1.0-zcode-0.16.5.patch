+// The DENY-PROBES scenario: a native edit is scheduled with a `file_path`,
+// the server probes permissions twice, both probes are denied by the host,
+// each denial is recorded, and the bounded turn still reaches its terminal.
+function sendPermissionProbe(sid, toolCallId) {
+  permSeq += 1;
+  const permId = `perm_${permSeq}`;
+  permissionWaiters.set(permId, (result) => {
+    const denied = !result || result.decision !== "allow";
+    if (!denied) {
+      event(sid, "turn.completed", { response: "unexpected allow", resultType: "success" });
+      return;
+    }
+    event(sid, "tool.updated", {
+      toolCallId,
